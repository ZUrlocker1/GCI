<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The game reads only its own bundle and writes only UserDefaults, so the
         sandbox needs no exceptions at all: no file access, no network, no
         hardware. Required for the App Store and harmless for Developer ID. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>

name: GalacticChessInvaders

options:
  bundleIdPrefix: com.zurlocker
  deploymentTarget:
    macOS: "14.0"
  xcodeVersion: "16.2"
  generateEmptyDirectories: false
  defaultConfig: Debug

targets:

  GalacticChessInvaders:
    type: application
    platform: macOS
    deploymentTarget: "14.0"
    sources:
      - path: GalacticChessInvaders
        excludes:
          - Tests/**
          # The UIKit shell, and the plist that goes with it. Each target sees
          # one shell and not the other's; everything under Game/ is shared.
          - App-iOS/**
          - Info-iOS.plist
          # Bundled as a folder reference below so the vendor subdirectories
          # survive; SoundKey resolves paths like "sfx/kenney-digital/x.caf",
          # and Xcode's default resource handling would flatten them.
          - Resources/sfx/**
          # Same again for the music, so the twenty tracks sit in one folder
          # rather than loose beside the icon and the font.
          - Resources/music/**
      - path: GalacticChessInvaders/Resources/sfx
        type: folder
      - path: GalacticChessInvaders/Resources/music
        type: folder
    settings:
      base:
        SWIFT_VERSION: 6.0
        MACOSX_DEPLOYMENT_TARGET: "14.0"
        PRODUCT_BUNDLE_IDENTIFIER: com.zurlocker.GalacticChessInvaders
        INFOPLIST_FILE: GalacticChessInvaders/Info.plist
        # In step with the .xcodeproj, and now verified rather than hoped:
        # `xcodegen generate` reproduces every build setting in every config
        # byte for byte. This file is the source of truth again, which is what
        # makes adding the iOS target a reviewable diff rather than surgery on
        # a 900-line pbxproj.
        CURRENT_PROJECT_VERSION: "9"
        MARKETING_VERSION: "1.2"
        SWIFT_STRICT_CONCURRENCY: complete
        # Signing, set up the way Zudio is. `DEVELOPMENT_TEAM` is the piece that
        # was missing: without it an archive carries no team and Xcode refuses to
        # distribute it — "No Team Found in Archive".
        DEVELOPMENT_TEAM: K66MA9TR8Z
        CODE_SIGN_STYLE: Manual
      configs:
        # Ad-hoc locally, so a debug build never waits on a certificate.
        #
        # The hardened runtime is deliberately NOT here. It blocks library
        # injection, which is how XCTest loads its bundle into the host app —
        # with it on, every test run failed to build. It was at `base` while
        # fixing a distribution error, which quietly broke ⌘U for a suite that
        # had never been run, so nothing noticed.
        Debug:
          CODE_SIGN_IDENTITY: "-"
          CODE_SIGNING_REQUIRED: NO
          ENABLE_HARDENED_RUNTIME: NO
          CODE_SIGN_ENTITLEMENTS: GalacticChessInvaders-Debug.entitlements
        # Automatic signing, and the hardened runtime with it: notarization
        # requires the runtime, and automatic signing is what lets one archive
        # produce both the notarized DMG and an App Store build.
        #
        # Deliberately NO `CODE_SIGN_IDENTITY`. Pinning it to "Developer ID
        # Application" is what this file used to say, and it is wrong twice
        # over: it contradicts `CODE_SIGN_STYLE: Automatic`, and it forces the
        # Developer ID certificate onto an App Store archive, which needs
        # Apple Distribution instead. Both were fixed in the .xcodeproj for
        # 1.0 and never written back here — so regenerating would have undone
        # the signing that got GCI onto the store.
        Release:
          CODE_SIGN_STYLE: Automatic
          CODE_SIGNING_REQUIRED: YES
          ENABLE_HARDENED_RUNTIME: YES
          CODE_SIGN_ENTITLEMENTS: GalacticChessInvaders.entitlements

  # The iOS build. Shares every line of Game/ with the Mac app and swaps the
  # shell: App/ is the AppKit one, App-iOS/ the UIKit one, and neither target
  # sees the other's. iOS 15 is the floor because `GCVirtualController` needs
  # it — see docs/IOS-Port.md §4.
  #
  # The bundle identifier is deliberately the *same* as the Mac app's, which
  # is how Zudio does it (`com.zudio.app` on both): one App Store record,
  # universal purchase, and GCI's §"Still open" question 2 answered by
  # precedent rather than by argument.
  GalacticChessInvadersiOS:
    type: application
    platform: iOS
    deploymentTarget: "15.0"
    sources:
      - path: GalacticChessInvaders
        excludes:
          - Tests/**
          - App/**            # the AppKit shell: NSApplication, NSTextView
          - Resources/sfx/**
          - Resources/music/**
          - Info.plist
      - path: GalacticChessInvaders/Resources/sfx
        type: folder
      - path: GalacticChessInvaders/Resources/music
        type: folder
    settings:
      base:
        SWIFT_VERSION: 6.0
        IPHONEOS_DEPLOYMENT_TARGET: "15.0"
        PRODUCT_BUNDLE_IDENTIFIER: com.zurlocker.GalacticChessInvaders
        INFOPLIST_FILE: GalacticChessInvaders/Info-iOS.plist
        CURRENT_PROJECT_VERSION: "9"
        MARKETING_VERSION: "1.2"
        SWIFT_STRICT_CONCURRENCY: complete
        DEVELOPMENT_TEAM: K66MA9TR8Z
        CODE_SIGN_STYLE: Automatic        # the way ZudioiOS is signed
        TARGETED_DEVICE_FAMILY: "1,2"     # iPhone and iPad
      configs:
        Debug:
          CODE_SIGN_IDENTITY: "-"
          CODE_SIGNING_REQUIRED: NO
        Release:
          CODE_SIGNING_REQUIRED: YES

  GCITests:
    type: bundle.unit-test
    platform: macOS
    deploymentTarget: "14.0"
    sources:
      - GalacticChessInvaders/Tests
    settings:
      base:
        SWIFT_VERSION: 6.0
        MACOSX_DEPLOYMENT_TARGET: "14.0"
        # The app points at a checked-in plist; a test bundle has nothing worth
        # keeping in one, and without either setting code signing refuses it.
        GENERATE_INFOPLIST_FILE: YES
        PRODUCT_BUNDLE_IDENTIFIER: com.zurlocker.GalacticChessInvadersTests
        BUNDLE_LOADER: "$(TEST_HOST)"
        TEST_HOST: "$(BUILT_PRODUCTS_DIR)/GalacticChessInvaders.app/Contents/MacOS/GalacticChessInvaders"
        # The test bundle needs a team too, or archiving the scheme fails on it
        # rather than on the app.
        DEVELOPMENT_TEAM: K66MA9TR8Z
        CODE_SIGN_STYLE: Automatic
      configs:
        # Match the host: a test bundle demanding a real identity cannot load
        # into an ad-hoc signed app.
        Debug:
          CODE_SIGN_IDENTITY: "-"
          CODE_SIGNING_REQUIRED: NO
        Release:
          CODE_SIGN_IDENTITY: "Apple Development"
    dependencies:
      - target: GalacticChessInvaders

schemes:
  GalacticChessInvaders:
    build:
      targets:
        GalacticChessInvaders: all
        GCITests: [test]
    run:
      config: Debug
    test:
      config: Debug
      targets:
        - GCITests
    profile:
      config: Release
    analyze:
      config: Debug
    archive:
      config: Release
